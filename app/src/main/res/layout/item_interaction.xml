<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_warning"
                android:padding="6dp"
                android:background="@drawable/bg_drug_icon"
                app:tint="@color/warning"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drug Interaction"
                android:textSize="16sp"
                android:textColor="@color/primary_text"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/severity_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODERATE"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_severity_badge"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/drug1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ibuprofen"
                android:textSize="15sp"
                android:textColor="@color/primary_blue"
                android:fontFamily="sans-serif-medium"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_swap"
                android:layout_marginHorizontal="8dp"
                app:tint="@color/secondary_text"/>

            <TextView
                android:id="@+id/drug2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aspirin"
                android:textSize="15sp"
                android:textColor="@color/primary_blue"
                android:fontFamily="sans-serif-medium"
                android:gravity="end"/>

        </LinearLayout>

        <TextView
            android:id="@+id/interaction_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ibuprofen may decrease the antiplatelet activities of Acetylsalicylic acid."
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>