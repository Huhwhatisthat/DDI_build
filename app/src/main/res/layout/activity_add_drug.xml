<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp"
            android:gravity="center_vertical"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="@color/primary_text"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Medication"
                android:textSize="24sp"
                android:textColor="@color/primary_text"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medication Name"
                android:textSize="14sp"
                android:textColor="@color/secondary_text"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/nickname_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary_blue"
                app:boxBackgroundColor="@color/white"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nickname_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g., Headache Pills"
                    android:textSize="16sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/secondary_text"
                    android:fontFamily="sans-serif"
                    android:paddingVertical="16dp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="How to add ingredient"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="16dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/scan_option_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_scan_option"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_camera"
                        android:padding="8dp"
                        android:background="@drawable/bg_icon_circle"
                        app:tint="@color/primary_blue"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan Label"
                            android:textSize="18sp"
                            android:textColor="@color/primary_text"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Use camera to detect active ingredient"
                            android:textSize="14sp"
                            android:textColor="@color/secondary_text"
                            android:fontFamily="sans-serif"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/primary_blue"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/manual_option_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_manual_option"
                android:padding="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_edit"
                        android:padding="8dp"
                        android:background="@drawable/bg_icon_circle"
                        app:tint="@color/accent_teal"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enter Manually"
                            android:textSize="18sp"
                            android:textColor="@color/primary_text"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Type the active ingredient yourself"
                            android:textSize="14sp"
                            android:textColor="@color/secondary_text"
                            android:fontFamily="sans-serif"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/accent_teal"/>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/camera_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scan Active Ingredient"
                    android:textSize="18sp"
                    android:textColor="@color/primary_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/camera_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                </androidx.cardview.widget.CardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/capture_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Capture Ingredient"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    app:icon="@drawable/ic_camera"
                    app:iconGravity="textStart"
                    app:iconSize="24dp"
                    android:backgroundTint="@color/primary_blue"
                    app:cornerRadius="16dp"
                    android:elevation="4dp"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_scan_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Cancel Scan"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/secondary_text"
                    app:backgroundTint="@color/surface_light"
                    app:cornerRadius="16dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/manual_entry_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Ingredient"
                    android:textSize="14sp"
                    android:textColor="@color/secondary_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ingredient_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/accent_teal"
                    app:boxBackgroundColor="@color/white"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ingredient_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., Ibuprofen"
                        android:textSize="16sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/secondary_text"
                        android:fontFamily="sans-serif"
                        android:paddingVertical="16dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prescription Details (Optional)"
                    android:textSize="16sp"
                    android:textColor="@color/primary_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantity"
                    android:textSize="14sp"
                    android:textColor="@color/secondary_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/quantity_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/primary_blue"
                    app:boxBackgroundColor="@color/white"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/quantity_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., 1"
                        android:inputType="number"
                        android:textSize="16sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/secondary_text"
                        android:fontFamily="sans-serif"
                        android:paddingVertical="16dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frequency"
                    android:textSize="14sp"
                    android:textColor="@color/secondary_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/frequency_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/primary_blue"
                    app:boxBackgroundColor="@color/white"
                    app:hintEnabled="false"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/frequency_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Select frequency"
                        android:inputType="none"
                        android:textSize="16sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/secondary_text"
                        android:fontFamily="sans-serif"
                        android:paddingVertical="16dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time (Optional)"
                    android:textSize="14sp"
                    android:textColor="@color/secondary_text"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/time_input_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/primary_blue"
                    app:boxBackgroundColor="@color/white"
                    app:hintEnabled="false"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_time">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/time_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., 10:30 AM"
                        android:focusable="false"
                        android:clickable="true"
                        android:textSize="16sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/secondary_text"
                        android:fontFamily="sans-serif"
                        android:paddingVertical="16dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_manual_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Save Medication"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconSize="24dp"
                    android:backgroundTint="@color/accent_teal"
                    app:cornerRadius="16dp"
                    android:elevation="4dp"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_manual_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Cancel"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/secondary_text"
                    app:backgroundTint="@color/surface_light"
                    app:cornerRadius="16dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>