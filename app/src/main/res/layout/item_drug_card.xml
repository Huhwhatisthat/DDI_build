<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with Icon and Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_pill_outlined"
                app:tint="@color/primary"
                android:padding="8dp"
                android:background="@drawable/action_card_background"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Delete Button -->
            <ImageView
                android:id="@+id/delete_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_delete_outlined"
                app:tint="@color/text_tertiary"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"/>

        </LinearLayout>

        <!-- Drug Nickname -->
        <TextView
            android:id="@+id/drug_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Medicine Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="12dp"/>

        <!-- Divider -->
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="@color/primary"
            android:layout_marginBottom="12dp"/>

        <!-- Active Ingredient Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active Ingredient"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.05"/>

        <!-- Drug Ingredient Badge -->
        <TextView
            android:id="@+id/drug_ingredient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ibuprofen"
            android:textSize="13sp"
            android:textColor="@color/ingredient_badge_text"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:background="@drawable/ingredient_badge"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
